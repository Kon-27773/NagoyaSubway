body {
    font-family: sans-serif;
    text-align: center;
    padding: 30px;
    background-color: #f5f5f5;
}

h1 {
    font-size: 24px;
}

.form {
    background-color: white;
    padding: 20px;
    border-radius: 10px;
    max-width: 400px;
    margin: auto;
}

label {
    display: block;
    margin-top: 10px;
}

select {
    width: 100%;
    padding: 10px;
    margin-top: 5px;
    font-size: 16px;
}

button {
    margin-top: 20px;
    padding: 10px 30px;
    font-size: 16px;
}

#result {
    margin: 20px auto;
    padding: 20px;
    max-width: 400px;
    background-color: white;
    border-radius: 10px;
    font-size: 18px;
}